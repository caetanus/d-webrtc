module tests.util.hmac_test;

import webrtc.util.hmac : hmacSha1;
import fluent.asserts : should;

@("HMAC-SHA1 matches the RFC 2202 test case 1 vector")
unittest
{
	ubyte[20] key = 0x0b; // 20 bytes of 0x0b
	auto mac = hmacSha1(key[], cast(ubyte[]) "Hi There");
	mac[].should.equal(cast(ubyte[])[
		0xb6, 0x17, 0x31, 0x86, 0x55, 0x05, 0x72, 0x64, 0xe2, 0x8b,
		0xc0, 0xb6, 0xfb, 0x37, 0x8c, 0x8e, 0xf1, 0x46, 0xbe, 0x00]);
}

@("HMAC-SHA1 matches the RFC 2202 test case 2 vector")
unittest
{
	// key "Jefe", data "what do ya want for nothing?"
	auto mac = hmacSha1(cast(ubyte[]) "Jefe", cast(ubyte[]) "what do ya want for nothing?");
	mac[].should.equal(cast(ubyte[])[
		0xef, 0xfc, 0xdf, 0x6a, 0xe5, 0xeb, 0x2f, 0xa2, 0xd2, 0x74,
		0x16, 0xd5, 0xf1, 0x84, 0xdf, 0x9c, 0x25, 0x9a, 0x7c, 0x79]);
}
