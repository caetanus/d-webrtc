{
	"name": "webrtc",
	"description": "Sans-io WebRTC data-channel engine for D (ICE + DTLS + SCTP + DCEP) — laundered from webrtc-rs's 'rtc', DTLS via OpenSSL",
	"authors": ["Marcelo A Caetano"],
	"license": "MIT",
	"targetType": "library",
	"sourcePaths": ["source"],
	"importPaths": ["source"],
	"dependencies": {
		"libsodiumd": "~>0.2",
		"openssl": "~>3.4"
	},
	"libs": ["crypto", "ssl"],
	"configurations": [
		{
			"name": "library",
			"targetType": "library"
		},
		{
			"name": "ut",
			"targetType": "executable",
			"targetName": "webrtc-test",
			"mainSourceFile": "tests/runner.d",
			"sourcePaths": ["source", "tests"],
			"importPaths": ["source", "tests"],
			"dependencies": {
				"unit-threaded": "~>2.2",
				"fluent-asserts": "~>2.0"
			},
			"dflags": ["-unittest"]
		}
	]
}
